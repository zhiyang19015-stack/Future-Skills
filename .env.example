# Copy to .env (local) or add as GitHub Codespaces secrets. Never commit a real .env.
#
# Optional: a language model to word the "Why this score?" text. Without a key the app writes the
# same facts with a template. Any OpenAI-compatible chat completions API works.
LLM_API_KEY=
# Leave empty for Fireworks AI, or give another API's base URL, e.g. https://api.openai.com/v1
LLM_BASE_URL=
# Leave empty for the default model (accounts/fireworks/models/gpt-oss-120b on Fireworks AI)
LLM_MODEL=

# Days between automatic "Update data" runs while the server is up (0 turns it off)
AUTO_UPDATE_DAYS=7
