{
  // GitHub Codespaces: Code -> Codespaces -> Create codespace on main.
  // The app uses only the Python standard library, so nothing is installed.
  "name": "Future Skills",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "Future Skills",
      "onAutoForward": "openBrowser"
    }
  },
  // Starts the web app every time the codespace is opened.
  "postAttachCommand": "PORT=5000 python src/main.py",
  // LLM_API_KEY / LLM_BASE_URL / LLM_MODEL come from Codespaces secrets when set.
  "secrets": {
    "LLM_API_KEY": { "description": "Optional: lets a language model word the \"Why this score?\" text." },
    "LLM_BASE_URL": { "description": "Optional: OpenAI-compatible API base URL." },
    "LLM_MODEL": { "description": "Optional: model id on that API." }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
